source(system.file("simulationStudy/breakdownMC.R",
                   package = "robustlmm"))
@

<<plot_breakdownMC_dyestuff,fig=TRUE,include=FALSE,height=4>>=
print(plot_breakdownMC_dyestuff)
@
<<plot_breakdownMC_penicillin,fig=TRUE,include=FALSE,height=5>>=
print(plot_breakdownMC_penicillin)
@
<<plot_breakdownMC_sleepstudy,fig=TRUE,include=FALSE,height=5>>=
print(plot_breakdownMC_sleepstudy)
@

